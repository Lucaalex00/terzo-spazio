# ---------------------------------------------------------------------------
# Terzo Spazio di Giulia Bordino — environment variables
# Copy this file to `.env.local` inside apps/web (or project root) and fill in
# the real values. NEVER commit the real .env / .env.local file.
# All NEXT_PUBLIC_* values are exposed to the browser (safe for non-secrets).
# ---------------------------------------------------------------------------

# Google Analytics 4 measurement id (loaded only after cookie consent).
# Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public WhatsApp number in international format, digits only (no +, spaces or
# dashes). Example for Italy: 393331234567. Used to build wa.me links.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Canonical public site URL (used for SEO metadata, sitemap and JSON-LD).
# In production set this to the final domain, e.g. https://www.giuliabordino.it
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: external booking app URL (Giulia's real booking system). The site's
# booking form acts only as a bridge toward this destination.
NEXT_PUBLIC_BOOKING_URL=
